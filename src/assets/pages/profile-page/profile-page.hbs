<main class="main profile-page">    
  <aside class="profile-page__sidebar sidebar">
    {{> link
        href="#chat"
        className="back__link"
     }}     
  </aside>
  <section class="profile-page__content profile">    
    <form class="form profile__form">
      <div class="profile__header">
        <div class="profile__image-wrapper">
            <img src="../../../public/images/user-defolt.svg" alt="avatar" class="profile__image">
            <div class="profile__image profile__image_overlay">
                Поменять<br>аватар
            </div>
        </div>
        <div class="profile__name">
          {{>title
          className="profile__title"
          title="Иван"
          }}
        </div>
      </div>
      <div class="profile__info">
        {{>input-profile
          id="email"
          nameInput="Почта"
          type="email"
          value="pochta@yandex.ru"
        }}
        
        {{>input-profile
          id="login"
          nameInput="Логин"
          type="text"
          value="ivanivanov"
        }}
        
        {{>input-profile
          id="first_name"
          nameInput="Имя"
          type="text"
          value="Иван"
        }}
        
        {{>input-profile
          id="second_name"
          nameInput="Фамилия"
          type="text"
          value="Иванов"
        }}
        
        {{>input-profile
          id="display_name"
          nameInput="Имя в чате"
          type="text"
          value="Иван"
        }}
        
        {{>input-profile
          id="phone"
          nameInput="Телефон"
          type="tel"
          value="+7 (909) 967 30 30"
        }}        
        <div class="profile__password">
          {{>input-profile
            id="old_password"
            nameInput="Старый пароль"
            type="password"
            value="•••••••••"
          }}
          {{>input-profile
            id="new_password"
            nameInput="Новый пароль"
            type="password"
            value="•••••••••••"
          }}
          {{>input-profile
            id="repeat_password"
            nameInput="Повторите новый пароль"
            type="password"
            value="•••••••••••"
          }}
        </div>
      </div>
      
      <div class="profile__actions" id="viewActions">
        {{>button
        type="button"
        className="profile__button"
        id="editBtn"
        buttonName="Изменить данные"
        }}

        {{>button
        type="button"
        className="profile__button"
        id="changeBtn"
        buttonName="Изменить пароль"
        }}        

        {{>button
        type="button"
        className="profile__button profile__button-logout"
        id="logoutBtn"
        buttonName="Выйти"
        }}
      </div>
    </form>
  </section>
</main>
