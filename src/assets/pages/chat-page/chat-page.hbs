<main class="main chat-page">
  <aside class="chat-page__sidebar sidebar">
    {{>link
      href="#profile"
      className="chat-page__profile"
      linkName="Профиль"
    }}
    <form class="sidebar__search search" action="#">
      {{>input
        type="text"
        name="search"
        placeholder="Поиск"
        className="search__input"      
      }}

      <div class="search__placeholder">
        <img src="../../../public/images/search.svg" alt="search">
        <span>Поиск</span>
      </div>
    </form>
    <nav class="chat-page__nav">
      <ul class="chat-list">
        {{#each chats}}
          {{> chat-item}}
        {{/each}}
      </ul>
    </nav>
  </aside>

  <section class="chat-page__content">
    {{>paragraph
    className="chat-page__paragraph"
    text="Выберите чат чтобы отправить сообщение"
    }}
    <div class="new-message">
      {{>input
        type="text"
        name="message"
        placeholder="Сообщение"
        className="new-message__input"   
        label="Сообщение"
      }}

      {{> button
       type="submit"
        className="new-message__button"
     }}      
    </div>
  </section>
</main>
