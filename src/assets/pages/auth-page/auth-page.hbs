<main class="main">
  <div class="auth__wrapper">
    <div class="auth">
      {{> title
        title="Вход"
      }} 
      <form class="form auth__form">
        <div class="form__fields">
          {{> input
            label="Логин"
            type="text"
            name="login"
            placeholder="Логин"
          }}
          
          {{> input
            label="Пароль"
            type="password"
            name="password"
            placeholder="Пароль"
          }}
        </div>
        
        <div class="form__action">
          {{> button
            type="submit"
            buttonName="Авторизоваться"
          }}

          {{> link
            href="#reg"
            linkName="Нет аккаунта?"
          }}
        </div>

      </form>
    </div>
  </div>
</main>
